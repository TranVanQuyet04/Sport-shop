# ============================================
# SPRING PROFILE - DOCKER
# ============================================
SPRING_PROFILES_ACTIVE=docker
SPRING_APPLICATION_NAME=SportSwearShopSystem

# ============================================
# DATABASE CONFIGURATION - DOCKER
# ============================================
DATABASE_NAME=SportSwearShop
DATABASE_URL=jdbc:postgresql://postgres:5432/SportSwearShop
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_PORT=5432

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET

# ============================================
# REDIS CONFIGURATION - DOCKER
# ============================================
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
REDIS_PORT=6379

# ============================================
# OPENAPI/SWAGGER CONFIGURATION
# ============================================
OPEN_API_TITLE=API-Sport Swear Shop Management
OPEN_API_VERSION=v1.0.0
OPEN_API_DESCRIPTION=Team 6
OPEN_API_SERVER_NAME=Docker Server

# ============================================
# JPA/HIBERNATE CONFIGURATION
# ============================================
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# ============================================
# APPLICATION CONFIGURATION
# ============================================
SERVER_PORT=8083
SERVER_SHUTDOWN=graceful
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=20s
APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8083
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://172.20.128.1:*
JWT_BLACKLIST_ENABLED=false

# ============================================
# HIKARI / LOGGING / INFO CONFIGURATION
# ============================================
SPRING_DATASOURCE_HIKARI_POOL_NAME=SportSwearShop
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=20000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=600000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=INFO
LOGGING_LEVEL_SPRING_WEB=WARN
LOGGING_LEVEL_HIBERNATE_SQL=WARN
LOGGING_PATTERN_CONSOLE=%d{yyyy-MM-dd HH:mm:ss} - %msg%n
LOG_FILE_PATH=/var/log/Sport-Swear-Shop/application.log
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_MAX_HISTORY=30
INFO_APP_NAME=Sport Swear Shop
INFO_APP_DESCRIPTION=Backend API for Sport Swear Shop System
INFO_APP_VERSION=1.0.0

# ============================================
# MOBILE / HARNESS CONFIGURATION
# ============================================
# Chỉ đặt SPORTSHOP_API_URL khi có API gateway thật; để trống sẽ tự định tuyến
# auth/catalog/order/chat lần lượt qua 8081/8082/8083/8084.
SPORTSHOP_API_URL=
SPORTSHOP_AUTH_API_URL=
SPORTSHOP_CATALOG_API_URL=
SPORTSHOP_ORDER_API_URL=
SPORTSHOP_CHAT_API_URL=
SPORTSHOP_WEB_URL=http://127.0.0.1:52777
SPORTSHOP_ADMIN_EMAIL=admin@example.com
SPORTSHOP_ADMIN_PASSWORD=quyet
SPORTSHOP_SHOP_STAFF_EMAIL=shopstaff@example.com
SPORTSHOP_SHOP_STAFF_PASSWORD=quyet
SPORTSHOP_MEMBER_EMAIL=member@example.com
SPORTSHOP_MEMBER_PASSWORD=quyet
SPORTSHOP_SHIPPER_EMAIL=shipper@example.com
SPORTSHOP_SHIPPER_PASSWORD=quyet
SPORTSHOP_ALLOW_MUTATING_ORDER_STATUS=false

# React/Vite cũng tự định tuyến microservice khi VITE_API_URL để trống.
VITE_API_URL=
VITE_AUTH_API_URL=http://localhost:8081
VITE_CATALOG_API_URL=http://localhost:8082
VITE_ORDER_API_URL=http://localhost:8083
VITE_CHAT_API_URL=http://localhost:8084
VITE_CHAT_WS_URL=http://localhost:8084/ws/chat

# ============================================
# SEED ACCOUNT CONFIGURATION
# ============================================
SEED_USER_DEFAULT_PASSWORD=quyet

SEED_ADMIN_FULL_NAME=Admin User
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PHONE=0123456789

SEED_SHOP_STAFF_FULL_NAME=Shop Staff User
SEED_SHOP_STAFF_EMAIL=shopstaff@example.com
SEED_SHOP_STAFF_PHONE=0323456789

SEED_SHIPPER_FULL_NAME=Shipper User
SEED_SHIPPER_EMAIL=shipper@example.com
SEED_SHIPPER_PHONE=0333456789

SEED_MEMBER_FULL_NAME=Member User
SEED_MEMBER_EMAIL=member@example.com
SEED_MEMBER_PHONE=0987654321

# ============================================
# MAIL CONFIGURATION
# ============================================
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=<SMTP username>
MAIL_PASSWORD=<SMTP password>
MAIL_FROM=no-reply@stridex.local
MAIL_FROM_NAME=StrideX
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

APP_MOBILE_RESET_PASSWORD_URL=stridex://app/reset-password

# ============================================
# VNPAY CONFIGURATION
# ============================================
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=CHANGE_ME_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=CHANGE_ME_VNPAY_HASH_SECRET
# Android emulator: http://10.0.2.2:8083/api/payment/vnpay_return
# Real devices/production: use a public HTTPS backend URL (ngrok/Cloudflare Tunnel/domain).
VNPAY_RETURN_URL=https://YOUR_PUBLIC_BACKEND/api/payment/vnpay_return
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay

# ORDER CONFIRMATION
ORDER_AUTO_COMPLETE_AFTER_DAYS=7
ORDER_AUTO_COMPLETE_CRON=0 0 * * * *

# ============================================
# GEMINI CONFIGURATION
# ============================================
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1/models/gemini-2.5-flash:generateContent

# ============================================
# OPENROUTER CONFIGURATION (SUPPORT CHAT)
# ============================================
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_API_KEY
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_TITLE=StrideX Sport Shop
CHAT_LOCAL_ENABLED=true
