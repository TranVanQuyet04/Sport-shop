  "flutterProUiRules": [
    "Every Admin list screen must have loading, empty, error, refresh, and bottom spacing states.",
    "Product-catalog child screens should keep bottomNavIndex 1.",
    "Fulfillment screens should keep bottomNavIndex 2.",
    "Staff/user screens should keep bottomNavIndex 3.",
    "Account/settings/chat support screens should keep bottomNavIndex 4 unless promoted to a dedicated module.",
    "Do not call API directly from View; View uses Controller, Controller uses Repository, Repository uses Service.",
    "Do not expose buttons for backend-unsupported features except as disabled coming-soon affordances."
  ]
